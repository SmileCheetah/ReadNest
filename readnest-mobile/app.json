{
  "expo": {
    "name": "Unwind",
    "slug": "readnest-mobile",
    "version": "0.1.0",
    "scheme": "readnest",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/unwind-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readnest.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.readnest.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/unwind-icon.png",
        "backgroundColor": "#f6f5f4"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f5f4",
          "image": "./assets/unwind-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cb2aef4c-1c73-4504-a520-f467409b134f"
      }
    },
    "owner": "kkzw18837"
  }
}
