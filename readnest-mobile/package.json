    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
