generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ArticleSource {
  THREADS
}

enum ProcessStatus {
  SAVED
  SUMMARIZING
  SUMMARY_DONE
  SUMMARY_FAILED
  CONTEXT_INSUFFICIENT
}

enum ReadStatus {
  UNREAD
  READ
  READ_LATER
}

enum ThreadGroupStatus {
  PARTIAL
  COMPLETE
  MERGED_SUMMARY_DONE
}

enum SummaryTaskState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum SummaryDensity {
  CONCISE
  DETAILED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  nickname        String
  articles        SavedArticle[]
  threadGroups    ThreadGroup[]
  knowledgeTopics KnowledgeTopic[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

model SavedArticle {
  id                   String        @id @default(cuid())
  userId               String
  source               ArticleSource @default(THREADS)
  url                  String        @db.Text
  normalizedUrl        String
  title                String?
  author               String?
  rawText              String?       @db.LongText
  summary              String?       @db.Text
  summaryMeta          Json?
  keyPoints            Json?
  tags                 Json?
  extractionStatus     String?
  extractionConfidence Float?
  summaryRetryCount    Int           @default(0)
  retryWindowStartedAt DateTime?
  lastSummaryError     String?       @db.Text
  generation           Int           @default(0)
  resultGeneration     Int?
  generatedAt          DateTime?
  summaryPreview       String?       @db.Text
  stage                String        @default("QUEUED")
  errorCode            String?
  retryable            Boolean       @default(true)
  retryAt              DateTime?
  sourceCompleteness   String        @default("UNKNOWN")
  processStatus        ProcessStatus @default(SAVED)
  readStatus           ReadStatus    @default(UNREAD)
  savedAt              DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadParts          ThreadPart[]
  summaryTasks         SummaryTask[]
  summaryVariants      SummaryVariant[]
  topicArticles        TopicArticle[]

  @@unique([userId, normalizedUrl])
  @@index([userId, savedAt])
  @@index([userId, processStatus])
  @@index([userId, readStatus])
  @@map("saved_articles")
}

model KnowledgeTopic {
  id          String         @id @default(cuid())
  userId      String
  name        String         @db.VarChar(80)
  // Hash of the NFKC/case/whitespace-normalized name, independent of DB collation.
  nameKey     String         @db.Char(64)
  description String?        @db.Text
  revision    Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles    TopicArticle[]

  @@unique([userId, nameKey])
  @@index([userId, createdAt, id])
  @@map("knowledge_topics")
}

model TopicArticle {
  topicId   String
  articleId String
  createdAt DateTime       @default(now())
  topic     KnowledgeTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  article   SavedArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([topicId, articleId])
  @@index([articleId, topicId])
  @@map("topic_articles")
}

model SummaryVariant {
  id               String           @id @default(cuid())
  articleId        String
  density          SummaryDensity
  generation       Int              @default(0)
  sourceGeneration Int
  state            SummaryTaskState @default(PENDING)
  markdown         String?          @db.LongText
  errorCode        String?
  retryable        Boolean          @default(true)
  retryAt          DateTime?
  lastError        String?          @db.Text
  generatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  article          SavedArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tasks            SummaryVariantTask[]

  @@unique([articleId, density])
  @@index([articleId, sourceGeneration])
  @@map("summary_variants")
}

model SummaryVariantTask {
  id               String           @id @default(cuid())
  variantId        String
  generation       Int
  sourceGeneration Int
  requestKey       String?
  state            SummaryTaskState @default(PENDING)
  attempts         Int              @default(0)
  notBefore        DateTime         @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  result           Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  variant          SummaryVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, generation])
  @@unique([variantId, requestKey])
  @@index([state, notBefore])
  @@index([state, leaseExpiresAt])
  @@map("summary_variant_tasks")
}

// Durable dispatch record. Network calls never run inside the DB transaction.
model SummaryTask {
  id             String           @id @default(cuid())
  articleId      String
  generation     Int
  requestKey     String?
  state          SummaryTaskState @default(PENDING)
  attempts       Int              @default(0)
  notBefore      DateTime         @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  result         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  article        SavedArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, generation])
  @@unique([articleId, requestKey])
  @@index([state, notBefore])
  @@index([state, leaseExpiresAt])
  @@map("summary_tasks")
}

model ThreadGroup {
  id        String            @id @default(cuid())
  userId    String
  title     String?
  status    ThreadGroupStatus @default(PARTIAL)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parts     ThreadPart[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, status])
  @@map("thread_groups")
}

model ThreadPart {
  id             String       @id @default(cuid())
  threadGroupId  String
  savedArticleId String
  partNumber     Int
  totalParts     Int
  url            String       @db.Text
  createdAt      DateTime     @default(now())
  threadGroup    ThreadGroup  @relation(fields: [threadGroupId], references: [id], onDelete: Cascade)
  savedArticle   SavedArticle @relation(fields: [savedArticleId], references: [id], onDelete: Cascade)

  @@unique([threadGroupId, partNumber])
  @@unique([savedArticleId])
  @@map("thread_parts")
}
