# Local development example. For KoDeploy, use .env.production.example as the checklist.
DATABASE_URL="mysql://readnest_user:YOUR_DB_PASSWORD@localhost:3306/readnest"
DB_HOST=""
DB_PORT=3306
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
NODE_ENV="development"
PORT=3000
JWT_SECRET="change-me-readnest-dev-secret"
JWT_EXPIRES_IN="7d"
# Development only. Production always rejects the guest endpoint.
GUEST_AUTH_ENABLED=true
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_TLS=false
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
DAILY_SAVE_LIMIT=50
SUMMARY_RETRY_LIMIT=3
# Manual regeneration allowance per article in this window (seconds).
SUMMARY_RETRY_WINDOW_SECONDS=3600
PLAYWRIGHT_CHANNEL="chrome"
PLAYWRIGHT_PAGE_TIMEOUT_MS=45000
PLAYWRIGHT_SCROLL_COUNT=3
EXTRACT_TEXT_LIMIT=50000
